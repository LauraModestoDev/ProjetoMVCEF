@page
@model LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Viagem - Login</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        /* FUNDO DA PÁGINA */

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 4.8%;

            background:
                linear-gradient(rgba(30, 40, 55, 0.35),
                                rgba(30, 40, 55, 0.50)),
                url('https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=2000&q=90')
                center / cover no-repeat fixed;
        }

        /* PAINEL PRINCIPAL */

        .container {
            width: 100%;
            max-width: 1268px;
            min-height: 90vh;
            border-radius: 22px;
            overflow: hidden;
            position: relative;

            display: flex;
            align-items: center;

            background:
                linear-gradient(rgba(20, 35, 50, 0.35),
                                rgba(20, 35, 50, 0.35)),
                url('https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=2000&q=90')
                center / cover no-repeat;

            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        /* LADO ESQUERDO */

        .left-content {
            width: 55%;
            padding: 8%;
            color: white;
            z-index: 1;
        }

        .logo {
            font-size: 46px;
            font-weight: 400;
            letter-spacing: -2px;
            margin-bottom: 30px;
            position: relative;
        }

        .logo span {
            font-size: 48px;
        }

        .logo small {
            font-size: 24px;
            position: absolute;
            top: -14px;
            left: 125px;
        }

        .left-content h1 {
            font-size: clamp(45px, 5vw, 68px);
            font-weight: 800;
            line-height: 0.95;
            letter-spacing: -2px;
            margin-bottom: 25px;
        }

        .left-content h2 {
            font-size: 21px;
            font-weight: 400;
            line-height: 1.3;
            margin-bottom: 16px;
        }

        .left-content p {
            font-size: 16px;
            line-height: 1.5;
            max-width: 360px;
        }

        /* CAIXA DE LOGIN */

        .login-box {
            width: 42%;
            max-width: 505px;
            min-width: 380px;
            padding: 52px;
            margin-right: 6%;

            background: rgba(220, 220, 220, 0.48);

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 32px;

            color: white;
            z-index: 2;
        }

        /* CAMPOS */

        .input-group {
            margin-bottom: 22px;
        }

        .input-group label {
            display: block;
            font-size: 16px;
            margin-bottom: 8px;
        }

        .input-group input {
            width: 100%;
            height: 53px;
            padding: 0 20px;

            border: none;
            outline: none;
            border-radius: 6px;

            background: white;
            color: #333;
            font-size: 15px;
        }

        .input-group input::placeholder {
            color: #999;
        }

        /* ESQUECEU A SENHA */

        .forgot {
            display: block;
            text-align: right;
            margin-top: -7px;
            margin-bottom: 27px;
        }

        .forgot a {
            color: white;
            font-size: 14px;
            text-decoration: underline;
        }

        /* BOTÃO ENTRAR */

        .btn-login {
            width: 100%;
            height: 53px;

            border: none;
            border-radius: 5px;

            background: #2785ed;
            color: white;

            font-size: 15px;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-login:hover {
            background: #126fd5;
        }

        /* DIVISOR */

        .divider {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 25px;

            margin: 32px 0;
            font-size: 16px;
        }

        .divider span {
            width: 95px;
            height: 1px;
            background: rgba(255, 255, 255, 0.8);
        }

        /* LOGIN GOOGLE */

        .google-login {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;

            color: white;
            text-decoration: none;
            font-size: 16px;

            margin-bottom: 36px;
            cursor: pointer;
        }

        .google-icon {
            width: 25px;
            height: 25px;
        }

        /* CADASTRO */

        .register {
            text-align: center;
            font-size: 15px;
        }

        .register a {
            color: white;
            text-decoration: underline;
        }

        /* RESPONSIVIDADE */

        @@media (max-width: 850px) {

            body {
                padding: 20px;
            }

            .container {
                min-height: auto;
                flex-direction: column;
                justify-content: center;
                padding: 50px 20px;
                gap: 35px;
            }

            .left-content {
                width: 100%;
                padding: 20px;
                text-align: center;
            }

            .left-content p {
                margin: auto;
            }

            .login-box {
                width: 100%;
                min-width: 0;
                max-width: 500px;
                margin: 0;
                padding: 35px;
            }
        }

        @@media (max-width: 450px) {

            .left-content h1 {
                font-size: 43px;
            }

            .logo {
                font-size: 38px;
            }

            .login-box {
                padding: 25px;
            }
        }

        .login-validation.validation-summary-valid,
        .login-validation.field-validation-valid {
            display: none;
        }

        .login-validation {
            display: block;
            margin-bottom: 12px;
            padding: 8px 12px;
            border-radius: 6px;
            color: #751728;
            background-color: #fff1f3;
            font-size: 14px;
        }

        .login-validation ul {
            padding-left: 18px;
        }

        .input-group .login-validation {
            margin-top: 6px;
        }

        button.google-login {
            width: 100%;
            background: transparent;
            border: 0;
        }

    </style>

</head>

<body>

    <main class="container">

        <!-- LADO ESQUERDO -->

        <section class="left-content">

            <div class="logo">
                <span>VIAGEM</span>
                <small>✈</small>
            </div>

            <h1>
                EXPLORE<br>
                HORIZONTES
            </h1>

            <h2>
                Onde os destinos dos seus sonhos<br>
                se tornam realidade.
            </h2>

            <p>
                Embarque em uma jornada onde cada
                canto do mundo está ao seu alcance.
            </p>

        </section>


        <!-- FORMULÁRIO DE LOGIN -->

        <section class="login-box">

            <form id="loginForm"
                  asp-page="./Login"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">

                <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

                <div class="input-group">
                    <label asp-for="Input.Email">E-mail</label>
                    <input asp-for="Input.Email" type="email" autocomplete="username"
                           placeholder="Digite seu e-mail" required />
                    <span asp-validation-for="Input.Email" class="login-validation"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Input.Password">Senha</label>
                    <input asp-for="Input.Password" type="password" autocomplete="current-password"
                           placeholder="***********" required />
                    <span asp-validation-for="Input.Password" class="login-validation"></span>
                </div>

                <div class="forgot">
                    <a asp-page="./ForgotPassword">Esqueceu sua senha?</a>
                </div>

                <button id="loginSubmit" type="submit" class="btn-login">ENTRAR</button>
            </form>

            @if (Model.ExternalLogins is { Count: > 0 } externalLogins)
            {
                <div class="divider"><span></span>ou<span></span></div>

                <form id="external-account" asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in externalLogins)
                    {
                        <button type="submit" class="google-login" name="provider" value="@provider.Name">
                            @if (provider.Name == "Google")
                            {
                            <svg class="google-icon"
                                 viewBox="0 0 48 48">
            
                                <path fill="#EA4335"
                                    d="M24 9.5c3.54 0 6.71 1.22
                                    9.21 3.6l6.85-6.85C35.9
                                    2.38 30.47 0 24 0
                                    14.62 0 6.51 5.38
                                    2.56 13.22l7.98 6.19
                                    C12.43 13.72 17.74 9.5 24 9.5z"/>
            
                                <path fill="#4285F4"
                                    d="M46.98 24.55c0-1.57-.15-3.09
                                    -.38-4.55H24v9.02h12.94
                                    c-.58 2.96-2.26 5.48
                                    -4.78 7.18l7.73 6
                                    c4.52-4.18 7.09-10.34
                                    7.09-17.65z"/>
            
                                <path fill="#FBBC05"
                                    d="M10.53 28.59A14.4 14.4
                                    0 0 1 9.75 24c0-1.59
                                    .27-3.12.75-4.59l-7.98
                                    -6.19A23.8 23.8 0 0 0
                                    0 24c0 3.87.93 7.52
                                    2.56 10.78l7.97-6.19z"/>
            
                                <path fill="#34A853"
                                    d="M24 48c6.48 0 11.93
                                    -2.13 15.89-5.8l-7.73
                                    -6c-2.15 1.45-4.92
                                    2.3-8.16 2.3-6.26
                                    0-11.57-4.22-13.47
                                    -9.91l-7.98 6.19C6.51
                                    42.62 14.62 48 24 48z"/>
            
                            </svg>
                            }
                            Entrar com @provider.DisplayName
                        </button>
                    }
                </form>
            }

            <!-- CRIAR CONTA -->

            <div class="register">

                É novo por aqui?

                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">

                    Criar uma conta

                </a>

            </div>

        </section>

    </main>

</body>

</html>