@page
@model RegisterModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Viagem - Criar Conta</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        /* FUNDO DA PÁGINA */

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 4.8%;

            background:
                linear-gradient(rgba(30, 40, 55, 0.35),
                                rgba(30, 40, 55, 0.50)),
                url('https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=2000&q=90')
                center / cover no-repeat fixed;
        }

        /* PAINEL PRINCIPAL */

        .container {
            width: 100%;
            max-width: 1268px;
            min-height: 90vh;
            border-radius: 22px;
            overflow: hidden;
            position: relative;

            display: flex;
            align-items: center;

            background:
                linear-gradient(rgba(20, 35, 50, 0.35),
                                rgba(20, 35, 50, 0.35)),
                url('https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=2000&q=90')
                center / cover no-repeat;

            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        /* LADO ESQUERDO */

        .left-content {
            width: 55%;
            padding: 8%;
            color: white;
            z-index: 1;
        }

        .logo {
            font-size: 46px;
            font-weight: 400;
            letter-spacing: -2px;
            margin-bottom: 30px;
            position: relative;
        }

        .logo span {
            font-size: 48px;
        }

        .logo small {
            font-size: 24px;
            position: absolute;
            top: -14px;
            left: 125px;
        }

        .left-content h1 {
            font-size: clamp(45px, 5vw, 68px);
            font-weight: 800;
            line-height: 0.95;
            letter-spacing: -2px;
            margin-bottom: 25px;
        }

        .left-content h2 {
            font-size: 21px;
            font-weight: 400;
            line-height: 1.3;
            margin-bottom: 16px;
        }

        .left-content p {
            font-size: 16px;
            line-height: 1.5;
            max-width: 360px;
        }

        /* CAIXA DE REGISTRO */

        .register-box {
            width: 42%;
            max-width: 505px;
            min-width: 380px;
            padding: 38px 52px;
            margin-right: 6%;

            background: rgba(220, 220, 220, 0.48);

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 32px;

            color: white;
            z-index: 2;
        }

        .register-box h2 {
            font-size: 25px;
            font-weight: 500;
            margin-bottom: 25px;
            text-align: center;
        }

        /* CAMPOS */

        .input-group {
            margin-bottom: 17px;
        }

        .input-group label {
            display: block;
            font-size: 15px;
            margin-bottom: 7px;
        }

        .input-group input {
            width: 100%;
            height: 48px;
            padding: 0 20px;

            border: none;
            outline: none;
            border-radius: 6px;

            background: white;
            color: #333;
            font-size: 15px;
        }

        .input-group input::placeholder {
            color: #999;
        }

        .input-group input:focus {
            box-shadow: 0 0 0 2px #2785ed;
        }

        .validation-error {
            color: #750c1c;
            font-size: 14px;
        }

        .validation-summary-errors,
        .field-validation-error {
            display: block;
            background: #fff3f4;
            border-radius: 6px;
            padding: 8px 12px;
            margin: 6px 0 12px;
        }

        .validation-summary-errors ul {
            padding-left: 20px;
        }

        .validation-summary-valid,
        .field-validation-valid {
            display: none;
        }

        /* BOTÃO CADASTRAR */

        .btn-register {
            width: 100%;
            height: 52px;

            border: none;
            border-radius: 5px;

            background: #2785ed;
            color: white;

            font-size: 15px;
            cursor: pointer;
            transition: 0.3s;

            margin-top: 8px;
        }

        .btn-register:hover {
            background: #126fd5;
        }

        /* DIVISOR */

        .divider {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 25px;

            margin: 25px 0;
            font-size: 16px;
        }

        .divider span {
            width: 95px;
            height: 1px;
            background: rgba(255, 255, 255, 0.8);
        }

        /* LOGIN */

        .login-link {
            text-align: center;
            font-size: 15px;
        }

        .login-link a {
            color: white;
            text-decoration: underline;
        }

        /* RESPONSIVIDADE */

        @@media (max-width: 850px) {

            body {
                padding: 20px;
            }

            .container {
                min-height: auto;
                flex-direction: column;
                justify-content: center;
                padding: 40px 20px;
                gap: 25px;
            }

            .left-content {
                width: 100%;
                padding: 20px;
                text-align: center;
            }

            .left-content p {
                margin: auto;
            }

            .register-box {
                width: 100%;
                min-width: 0;
                max-width: 500px;
                margin: 0;
                padding: 35px;
            }
        }

        @@media (max-width: 450px) {

            .left-content h1 {
                font-size: 43px;
            }

            .logo {
                font-size: 38px;
            }

            .register-box {
                padding: 25px;
            }
        }

    </style>

</head>

<body>

    <main class="container">

        <!-- LADO ESQUERDO -->

        <section class="left-content">

            <div class="logo">
                <span>VIAGEM</span>
                <small>✈</small>
            </div>

            <h1>
                EXPLORE<br>
                HORIZONTES
            </h1>

            <h2>
                Sua próxima aventura<br>
                começa aqui!
            </h2>

            <p>
                Crie sua conta e descubra novos destinos,
                experiências incríveis e lugares
                inesquecíveis pelo mundo.
            </p>

        </section>


        <!-- FORMULÁRIO DE REGISTRO -->

        <section class="register-box">

            <h2>Crie sua conta</h2>

            <form id="registerForm" asp-page="./Register"
                  asp-route-returnUrl="@Model.ReturnUrl" method="post">

                <div asp-validation-summary="ModelOnly" class="validation-error" role="alert"></div>

                <div class="input-group">
                    <label asp-for="Input.Email">E-mail</label>
                    <input asp-for="Input.Email" type="email" autocomplete="username"
                           placeholder="Digite seu e-mail" required />
                    <span asp-validation-for="Input.Email" class="validation-error"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Input.Password">Senha</label>
                    <input asp-for="Input.Password" type="password" autocomplete="new-password"
                           placeholder="Crie uma senha" required />
                    <span asp-validation-for="Input.Password" class="validation-error"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Input.ConfirmPassword">Confirmar senha</label>
                    <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password"
                           placeholder="Digite sua senha novamente" required />
                    <span asp-validation-for="Input.ConfirmPassword" class="validation-error"></span>
                </div>

                <button id="registerSubmit" type="submit" class="btn-register">
                    CRIAR CONTA
                </button>

            </form>

            @if (Model.ExternalLogins is { Count: > 0 } externalLogins)
            {
                <div class="divider"><span></span>ou<span></span></div>

                <form id="external-account" asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in externalLogins)
                    {
                        <button type="submit" class="btn-register" name="provider" value="@provider.Name">
                            Cadastrar com @provider.DisplayName
                        </button>
                    }
                </form>
            }

            <!-- VOLTAR PARA LOGIN -->

            <div class="login-link">

                Já possui uma conta?

                <a asp-area="Identity" asp-page="/Account/Login"
                   asp-route-returnUrl="@Model.ReturnUrl">

                    Fazer login

                </a>

            </div>

        </section>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

</body>

</html>
