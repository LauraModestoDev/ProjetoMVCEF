@page
@model RegisterModel


@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Viagem - Criar Conta</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        /* FUNDO DA PÁGINA */

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 4.8%;

            background:
                linear-gradient(rgba(30, 40, 55, 0.35),
                                rgba(30, 40, 55, 0.50)),
                url('https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=2000&q=90')
                center / cover no-repeat fixed;
        }

        /* PAINEL PRINCIPAL */

        .container {
            width: 100%;
            max-width: 1268px;
            min-height: 90vh;
            border-radius: 22px;
            overflow: hidden;
            position: relative;

            display: flex;
            align-items: center;

            background:
                linear-gradient(rgba(20, 35, 50, 0.35),
                                rgba(20, 35, 50, 0.35)),
                url('https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=2000&q=90')
                center / cover no-repeat;

            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        /* LADO ESQUERDO */

        .left-content {
            width: 55%;
            padding: 8%;
            color: white;
            z-index: 1;
        }

        .logo {
            font-size: 46px;
            font-weight: 400;
            letter-spacing: -2px;
            margin-bottom: 30px;
            position: relative;
        }

        .logo span {
            font-size: 48px;
        }

        .logo small {
            font-size: 24px;
            position: absolute;
            top: -14px;
            left: 125px;
        }

        .left-content h1 {
            font-size: clamp(45px, 5vw, 68px);
            font-weight: 800;
            line-height: 0.95;
            letter-spacing: -2px;
            margin-bottom: 25px;
        }

        .left-content h2 {
            font-size: 21px;
            font-weight: 400;
            line-height: 1.3;
            margin-bottom: 16px;
        }

        .left-content p {
            font-size: 16px;
            line-height: 1.5;
            max-width: 360px;
        }

        /* CAIXA DE REGISTRO */

        .register-box {
            width: 42%;
            max-width: 505px;
            min-width: 380px;
            padding: 38px 52px;
            margin-right: 6%;

            background: rgba(220, 220, 220, 0.48);

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 32px;

            color: white;
            z-index: 2;
        }

        .register-box h2 {
            font-size: 25px;
            font-weight: 500;
            margin-bottom: 25px;
            text-align: center;
        }

        /* CAMPOS */

        .input-group {
            margin-bottom: 17px;
        }

        .input-group label {
            display: block;
            font-size: 15px;
            margin-bottom: 7px;
        }

        .input-group input {
            width: 100%;
            height: 48px;
            padding: 0 20px;

            border: none;
            outline: none;
            border-radius: 6px;

            background: white;
            color: #333;
            font-size: 15px;
        }

        .input-group input::placeholder {
            color: #999;
        }

        .input-group input:focus {
            box-shadow: 0 0 0 2px #2785ed;
        }

        /* BOTÃO CADASTRAR */

        .btn-register {
            width: 100%;
            height: 52px;

            border: none;
            border-radius: 5px;

            background: #2785ed;
            color: white;

            font-size: 15px;
            cursor: pointer;
            transition: 0.3s;

            margin-top: 8px;
        }

        .btn-register:hover {
            background: #126fd5;
        }

        /* DIVISOR */

        .divider {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 25px;

            margin: 25px 0;
            font-size: 16px;
        }

        .divider span {
            width: 95px;
            height: 1px;
            background: rgba(255, 255, 255, 0.8);
        }

        /* GOOGLE */

        .google-register {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;

            color: white;
            text-decoration: none;
            font-size: 15px;

            margin-bottom: 25px;
            cursor: pointer;
        }

        .google-icon {
            width: 25px;
            height: 25px;
        }

        /* LOGIN */

        .login-link {
            text-align: center;
            font-size: 15px;
        }

        .login-link a {
            color: white;
            text-decoration: underline;
        }

        /* RESPONSIVIDADE */

        @@media (max-width: 850px) {

            body {
                padding: 20px;
            }

            .container {
                min-height: auto;
                flex-direction: column;
                justify-content: center;
                padding: 40px 20px;
                gap: 25px;
            }

            .left-content {
                width: 100%;
                padding: 20px;
                text-align: center;
            }

            .left-content p {
                margin: auto;
            }

            .register-box {
                width: 100%;
                min-width: 0;
                max-width: 500px;
                margin: 0;
                padding: 35px;
            }
        }

        @@media (max-width: 450px) {

            .left-content h1 {
                font-size: 43px;
            }

            .logo {
                font-size: 38px;
            }

            .register-box {
                padding: 25px;
            }
        }

    </style>

</head>

<body>

    <main class="container">

        <!-- LADO ESQUERDO -->

        <section class="left-content">

            <div class="logo">
                <span>VIAGEM</span>
                <small>✈</small>
            </div>

            <h1>
                EXPLORE<br>
                HORIZONTES
            </h1>

            <h2>
                Sua próxima aventura<br>
                começa aqui!
            </h2>

            <p>
                Crie sua conta e descubra novos destinos,
                experiências incríveis e lugares
                inesquecíveis pelo mundo.
            </p>

        </section>


        <!-- FORMULÁRIO DE REGISTRO -->

        <section class="register-box">

            <h2>Crie sua conta</h2>

            <form method="post"
                  asp-controller="Account"
                  asp-action="Register">

                @Html.AntiForgeryToken()

                <!-- NOME -->

                <div class="input-group">

                    <label for="nome">Nome completo</label>

                    <input
                        type="text"
                        id="nome"
                        name="Nome"
                        placeholder="Digite seu nome completo"
                        autocomplete="name"
                        required>

                </div>


                <!-- EMAIL -->

                <div class="input-group">

                    <label for="email">E-mail</label>

                    <input
                        type="email"
                        id="email"
                        name="Email"
                        placeholder="Digite seu e-mail"
                        autocomplete="email"
                        required>

                </div>


                <!-- SENHA -->

                <div class="input-group">

                    <label for="senha">Senha</label>

                    <input
                        type="password"
                        id="senha"
                        name="Senha"
                        placeholder="Crie uma senha"
                        autocomplete="new-password"
                        minlength="8"
                        required>

                </div>


                <!-- CONFIRMAR SENHA -->

                <div class="input-group">

                    <label for="confirmarSenha">
                        Confirmar senha
                    </label>

                    <input
                        type="password"
                        id="confirmarSenha"
                        name="ConfirmarSenha"
                        placeholder="Digite sua senha novamente"
                        autocomplete="new-password"
                        minlength="8"
                        required>

                </div>


                <!-- BOTÃO -->

                <button type="submit" class="btn-register">

                    CRIAR CONTA

                </button>

            </form>


            <!-- DIVISOR -->

            <div class="divider">

                <span></span>

                ou

                <span></span>

            </div>


            <!-- CADASTRO GOOGLE -->

            <a href="#" class="google-register">

                <svg class="google-icon"
                     viewBox="0 0 48 48">

                    <path fill="#EA4335"
                        d="M24 9.5c3.54 0 6.71 1.22
                        9.21 3.6l6.85-6.85C35.9
                        2.38 30.47 0 24 0
                        14.62 0 6.51 5.38
                        2.56 13.22l7.98 6.19
                        C12.43 13.72 17.74 9.5 24 9.5z"/>

                    <path fill="#4285F4"
                        d="M46.98 24.55c0-1.57-.15-3.09
                        -.38-4.55H24v9.02h12.94
                        c-.58 2.96-2.26 5.48
                        -4.78 7.18l7.73 6
                        c4.52-4.18 7.09-10.34
                        7.09-17.65z"/>

                    <path fill="#FBBC05"
                        d="M10.53 28.59A14.4 14.4
                        0 0 1 9.75 24c0-1.59
                        .27-3.12.75-4.59l-7.98
                        -6.19A23.8 23.8 0 0 0
                        0 24c0 3.87.93 7.52
                        2.56 10.78l7.97-6.19z"/>

                    <path fill="#34A853"
                        d="M24 48c6.48 0 11.93
                        -2.13 15.89-5.8l-7.73
                        -6c-2.15 1.45-4.92
                        2.3-8.16 2.3-6.26
                        0-11.57-4.22-13.47
                        -9.91l-7.98 6.19C6.51
                        42.62 14.62 48 24 48z"/>

                </svg>

                Cadastrar com o Google

            </a>


            <!-- VOLTAR PARA LOGIN -->

            <div class="login-link">

                Já possui uma conta?

                <a asp-controller="Account"
                   asp-action="Login">

                    Fazer login

                </a>

            </div>

        </section>

    </main>

</body>

</html>
